From 33bcd19373b367f81407bd983f09ed645190b16f Mon Sep 17 00:00:00 2001
From: Arran Ubels <arran4@gmail.com>
Date: Tue, 1 Sep 2026 09:25:00 +1000
Subject: [PATCH] build: add remaining explicit Qt 6.11 includes

Caelestia 2.4.0 incorporated several of the explicit Qt includes previously
carried by this patch. Keep only the headers that are still used directly but
not included explicitly, avoiding reliance on transitive Qt includes.
---
 plugin/src/Caelestia/Images/iutils.hpp             | 1 +
 plugin/src/Caelestia/Services/lyriccandidate.hpp  | 1 +
 plugin/src/Caelestia/Services/lyrics.hpp          | 1 +
 plugin/src/Caelestia/Services/sessionmanager.cpp  | 1 +
 plugin/src/Caelestia/Services/storage.hpp         | 2 ++
 plugin/src/Caelestia/Services/usagefmt.hpp        | 2 ++
 6 files changed, 8 insertions(+)

diff --git a/plugin/src/Caelestia/Images/iutils.hpp b/plugin/src/Caelestia/Images/iutils.hpp
--- a/plugin/src/Caelestia/Images/iutils.hpp
+++ b/plugin/src/Caelestia/Images/iutils.hpp
@@ -1,7 +1,8 @@
 #pragma once
 
 #include <qobject.h>
 #include <qqmlintegration.h>
+#include <qqmlengine.h>
 #include <qurl.h>
 
 namespace caelestia::images {
diff --git a/plugin/src/Caelestia/Services/lyriccandidate.hpp b/plugin/src/Caelestia/Services/lyriccandidate.hpp
--- a/plugin/src/Caelestia/Services/lyriccandidate.hpp
+++ b/plugin/src/Caelestia/Services/lyriccandidate.hpp
@@ -1,7 +1,8 @@
 #pragma once
 
 #include <qobject.h>
 #include <qqmlintegration.h>
+#include <qstring.h>
 
 #include "../Config/enums.hpp"
 
diff --git a/plugin/src/Caelestia/Services/lyrics.hpp b/plugin/src/Caelestia/Services/lyrics.hpp
--- a/plugin/src/Caelestia/Services/lyrics.hpp
+++ b/plugin/src/Caelestia/Services/lyrics.hpp
@@ -5,7 +5,8 @@
 #include <qhash.h>
 #include <qjsonobject.h>
 #include <qnetworkaccessmanager.h>
 #include <qnetworkreply.h>
+#include <qpointer.h>
 #include <qtimer.h>
 
 namespace caelestia::services {
diff --git a/plugin/src/Caelestia/Services/sessionmanager.cpp b/plugin/src/Caelestia/Services/sessionmanager.cpp
--- a/plugin/src/Caelestia/Services/sessionmanager.cpp
+++ b/plugin/src/Caelestia/Services/sessionmanager.cpp
@@ -7,6 +7,7 @@
 #include <QtDBus/qdbuspendingreply.h>
 #include <QtDBus/qdbusreply.h>
 #include <qloggingcategory.h>
+#include <qqmlengine.h>
 
 #include "../toaster.hpp"
 
diff --git a/plugin/src/Caelestia/Services/storage.hpp b/plugin/src/Caelestia/Services/storage.hpp
--- a/plugin/src/Caelestia/Services/storage.hpp
+++ b/plugin/src/Caelestia/Services/storage.hpp
@@ -4,8 +4,10 @@
 #include "tickingservice.hpp"
 
 #include <qbytearrayview.h>
+#include <qpointer.h>
 #include <qqmlintegration.h>
 #include <qqmllist.h>
+#include <qstringlist.h>
 #include <qvariant.h>
 
 namespace caelestia::services {
diff --git a/plugin/src/Caelestia/Services/usagefmt.hpp b/plugin/src/Caelestia/Services/usagefmt.hpp
--- a/plugin/src/Caelestia/Services/usagefmt.hpp
+++ b/plugin/src/Caelestia/Services/usagefmt.hpp
@@ -1,5 +1,7 @@
 #pragma once
 
+#include <qobject.h>
 #include <qqmlintegration.h>
+#include <qstring.h>
 
 namespace caelestia::services::usagefmt {
