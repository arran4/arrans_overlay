# Loaded automatically for app-shells/a4sh; no package.env entry is needed.
# The portage user's gh authentication must already be configured by an admin.
GH_CONFIG_DIR="/var/lib/portage/home/.config/gh"

# Inject the HTTPS credential helper without changing GIT_CONFIG_GLOBAL.
# git-r3 needs to write safe.directory to its temporary global git config.
# Scope the helper to github.com rather than all Git remotes.
GIT_CONFIG_COUNT=1
GIT_CONFIG_KEY_0="credential.https://github.com.helper"
GIT_CONFIG_VALUE_0="!gh auth git-credential"

# This file is a package-specific bashrc, not a package.env assignment file.
export GH_CONFIG_DIR GIT_CONFIG_COUNT GIT_CONFIG_KEY_0 GIT_CONFIG_VALUE_0
