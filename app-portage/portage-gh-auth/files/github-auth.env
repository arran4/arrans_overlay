# Use with an opt-in /etc/portage/package.env entry:
# app-shells/a4sh github-auth
# Reuse the portage user's gh login; do not copy credentials into the build.
GH_CONFIG_DIR="/var/lib/portage/home/.config/gh"

# Inject a GitHub HTTPS credential helper, without redirecting the writable
# per-build global Git config needed by git-r3 for safe.directory entries.
GIT_CONFIG_COUNT="1"
GIT_CONFIG_KEY_0="credential.https://github.com.helper"
GIT_CONFIG_VALUE_0="!gh auth git-credential"
