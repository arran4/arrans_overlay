BDEPEND=
	virtual/pkgconfig
	wayland? ( dev-libs/wayland-protocols )

DEPEND=
	X? (
		x11-libs/libX11
		x11-libs/libXext
		x11-libs/libXfixes
		x11-libs/libXinerama
		x11-libs/libXrandr
		x11-libs/cairo
		x11-libs/pango
	)
	wayland? (
		dev-libs/wayland
		x11-libs/cairo
		x11-libs/pango
	)
	libconfig? ( dev-libs/libconfig:= )

DESCRIPTION=The 'Activate Windows' watermark ported to Linux
EAPI=8
HOMEPAGE=https://github.com/MrGlockenspiel/activate-linux
INHERITED=toolchain-funcs
IUSE=wayland X libconfig
KEYWORDS=~amd64
LICENSE=GPL-3
RDEPEND=
	X? (
		x11-libs/libX11
		x11-libs/libXext
		x11-libs/libXfixes
		x11-libs/libXinerama
		x11-libs/libXrandr
		x11-libs/cairo
		x11-libs/pango
	)
	wayland? (
		dev-libs/wayland
		x11-libs/cairo
		x11-libs/pango
	)
	libconfig? ( dev-libs/libconfig:= )

REQUIRED_USE=|| ( wayland X )
SLOT=0
